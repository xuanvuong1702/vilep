{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:5080",
  "Database": {
    "Provider": "sqlite",
    "ConnectionString": "Data Source={DataDir}/vilep.db"
  },
  "Jwt": {
    "Issuer": "vilep",
    "Audience": "vilep-app",
    "Key": "vilep-dev-signing-key-please-change-0123456789abcdef",
    "AccessMinutes": 240,
    "RefreshDays": 30
  },
  "Payments": {
    "Provider": "mock",
    "WebhookSecret": "vilep-dev-webhook-secret-change-me",
    "AutoApprovePayoutLimit": 500000,
    "ProcessingFeeBps": 0,
    "TipSuggestPercent": 5,
    "ClientId": "",
    "ApiKey": "",
    "ChecksumKey": "",
    "BaseUrl": "https://api-merchant.payos.vn"
  },
  "Vilep": {
    "BaseUrl": "http://localhost:5080",
    "MinContribution": 10000,
    "FunModeAMin": 20000,
    "FunModeAMax": 500000,
    "FunModeBMax": 300000,
    "CreditorInviteHours": 72,
    "MaxActiveCasesModeA": 2,
    "MaxActiveCasesModeB": 1,
    "DefaultFundraisingDays": 30,
    "HoldDays": 3,
    "ExposeOtpInResponse": true,
    "AutoVerifyKyc": true,
    "EnableDevPayments": true
  },
  "Seed": {
    "Enabled": true
  },
  "Jobs": {
    "IntervalSeconds": 60
  },
  "Swagger": {
    "Enabled": true
  }
}
