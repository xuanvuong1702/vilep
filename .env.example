# Sao chép thành .env rồi đổi giá trị trước khi deploy.
POSTGRES_PASSWORD=vilep

# Bắt buộc đổi ở production (>= 32 ký tự)
JWT_KEY=change-me-in-production-0123456789abcdef0123456789

# Khoá AES-256-GCM cho số tài khoản ngân hàng (base64, 32 byte)
# Tạo bằng: openssl rand -base64 32
ENCRYPTION_KEY=

# mock | payos
PAYMENTS_PROVIDER=mock
WEBHOOK_SECRET=change-me-webhook-secret

# PayOS sandbox/production keys (khi PAYMENTS_PROVIDER=payos)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

PUBLIC_BASE_URL=http://localhost:5080

# Chỉ bật ở môi trường dev/demo
EXPOSE_OTP=true
ENABLE_DEV_PAYMENTS=true
SEED_ENABLED=true
